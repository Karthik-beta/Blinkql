# Normalise line endings to LF in the repository and in every checkout,
# so Windows and Unix contributors produce identical diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.{bat,cmd,ps1} text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.wasm binary
*.parquet binary

# Generated: collapse in diffs and exclude from language stats
pnpm-lock.yaml linguist-generated=true -diff
